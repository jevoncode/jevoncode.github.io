path":"api/categories/AI-Agent.json"}],"tags":[{"name":"OpenClaw","slug":"OpenClaw","count":6,"path":"api/tags/OpenClaw.json"},{"name":"教程","slug":"教程","count":5,"path":"api/tags/教程.json"},{"name":"AI Agent","slug":"AI-Agent","count":5,"path":"api/tags/AI-Agent.json"},{"name":"开源","slug":"开源","count":1,"path":"api/tags/开源.json"}],"toc":"<ol class=\"toc\"><li class=\"toc-item toc-level-2\"><a class=\"toc-link\" href=\"#%E4%BB%8A%E5%A4%A9%E4%BD%A0%E5%B0%86%E5%AD%A6%E5%88%B0\"><span class=\"toc-text\">今天你将学到</span></a></li><li class=\"toc-item toc-level-2\"><a class=\"toc-link\" href=\"#1-Gateway-%E2%80%94%E2%80%94-%E7%B3%BB%E7%BB%9F%E7%9A%84%E5%BF%83%E8%84%8F\"><span class=\"toc-text\">1. Gateway —— 系统的心脏</span></a><ol class=\"toc-child\"><li class=\"toc-item toc-level-3\"><a class=\"toc-link\" href=\"#%E5%90%AF%E5%8A%A8%E5%92%8C%E7%AE%A1%E7%90%86-Gateway\"><span class=\"toc-text\">启动和管理 Gateway</span></a></li><li class=\"toc-item toc-level-3\"><a class=\"toc-link\" href=\"#Gateway-%E9%85%8D%E7%BD%AE%E6%96%87%E4%BB%B6\"><span class=\"toc-text\">Gateway 配置文件</span></a></li><li class=\"toc-item toc-level-3\"><a class=\"toc-link\" href=\"#%E9%85%8D%E7%BD%AE%E7%83%AD%E9%87%8D%E8%BD%BD\"><span class=\"toc-text\">配置热重载</span></a></li><li class=\"toc-item toc-level-3\"><a class=\"toc-link\" href=\"#%E9%85%8D%E7%BD%AE%E9%AA%8C%E8%AF%81\"><span class=\"toc-text\">配置验证</span></a></li></ol></li><li class=\"toc-item toc-level-2\"><a class=\"toc-link\" href=\"#2-Agent-%E2%80%94%E2%80%94-AI-%E7%9A%84%E2%80%9D%E5%A4%A7%E8%84%91%E2%80%9D%E5%92%8C%E2%80%9D%E4%BA%BA%E6%A0%BC%E2%80%9D\"><span class=\"toc-text\">2. Agent —— AI 的”大脑”和”人格”</span></a><ol class=\"toc-child\"><li class=\"toc-item toc-level-3\"><a class=\"toc-link\" href=\"#%E5%8D%95-Agent-%E6%A8%A1%E5%BC%8F-vs-%E5%A4%9A-Agent-%E6%A8%A1%E5%BC%8F\"><span class=\"toc-text\">单 Agent 模式 vs 多 Agent 模式</span></a></li><li class=\"toc-item toc-level-3\"><a class=\"toc-link\" href=\"#%E5%B7%A5%E4%BD%9C%E7%A9%BA%E9%97%B4%E6%96%87%E4%BB%B6\"><span class=\"toc-text\">工作空间文件</span></a></li><li class=\"toc-item toc-level-3\"><a class=\"toc-link\" href=\"#%E5%AE%9E%E9%99%85%E6%93%8D%E4%BD%9C%EF%BC%9A%E5%AE%9A%E5%88%B6%E4%BD%A0%E7%9A%84-Agent\"><span class=\"toc-text\">实际操作：定制你的 Agent</span></a></li></ol></li><li class=\"toc-item toc-level-2\"><a class=\"toc-link\" href=\"#3-Session-%E2%80%94%E2%80%94-%E5%AF%B9%E8%AF%9D%E7%9A%84%E4%B8%8A%E4%B8%8B%E6%96%87%E7%AE%A1%E7%90%86\"><span class=\"toc-text\">3. Session —— 对话的上下文管理</span></a><ol class=\"toc-child\"><li class=\"toc-item toc-level-3\"><a class=\"toc-link\" href=\"#Session-%E4%BD%9C%E7%94%A8%E5%9F%9F\"><span class=\"toc-text\">Session 作用域</span></a></li><li class=\"toc-item toc-level-3\"><a class=\"toc-link\" href=\"#Session-%E9%87%8D%E7%BD%AE\"><span class=\"toc-text\">Session 重置</span></a></li><li class=\"toc-item toc-level-3\"><a class=\"toc-link\" href=\"#%E6%9F%A5%E7%9C%8B%E5%92%8C%E7%AE%A1%E7%90%86-Session\"><span class=\"toc-text\">查看和管理 Session</span></a></li></ol></li><li class=\"toc-item toc-level-2\"><a class=\"toc-link\" href=\"#4-Channel-%E2%80%94%E2%80%94-%E8%BF%9E%E6%8E%A5%E8%81%8A%E5%A4%A9%E5%B9%B3%E5%8F%B0\"><span class=\"toc-text\">4. Channel —— 连接聊天平台</span></a><ol class=\"toc-child\"><li class=\"toc-item toc-level-3\"><a class=\"toc-link\" href=\"#%E6%94%AF%E6%8C%81%E7%9A%84%E9%A2%91%E9%81%93\"><span class=\"toc-text\">支持的频道</span></a></li><li class=\"toc-item toc-level-3\"><a class=\"toc-link\" href=\"#%E9%85%8D%E7%BD%AE%E9%A2%91%E9%81%93%EF%BC%88%E4%BB%A5-Telegram-%E4%B8%BA%E4%BE%8B%EF%BC%89\"><span class=\"toc-text\">配置频道（以 Telegram 为例）</span></a></li><li class=\"toc-item toc-level-3\"><a class=\"toc-link\" href=\"#DM-%E8%AE%BF%E9%97%AE%E7%AD%96%E7%95%A5\"><span class=\"toc-text\">DM 访问策略</span></a></li><li class=\"toc-item toc-level-3\"><a class=\"toc-link\" href=\"#%E7%BE%A4%E8%81%8A%E9%85%8D%E7%BD%AE\"><span class=\"toc-text\">群聊配置</span></a></li></ol></li><li class=\"toc-item toc-level-2\"><a class=\"toc-link\" href=\"#5-%